<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    android:backgroundTint="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header con ID y Disciplina -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_class_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#001"
                android:textSize="12sp"
                android:textColor="#6C757D"
                android:background="#E9ECEF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_discipline_catalog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Matemáticas Avanzadas"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#212529" />

        </LinearLayout>

        <!-- Información del profesor -->
        <TextView
            android:id="@+id/tv_professor_catalog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Prof: Dr. Juan Pérez"
            android:textSize="14sp"
            android:textColor="#495057"
            android:textStyle="bold" />

        <!-- Detalles de la clase -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_location_catalog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 Aula 201 - Edificio Principal"
                android:textSize="13sp"
                android:textColor="#6C757D"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_schedule_catalog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🕐 Lun-Mié-Vie 10:00-12:00"
                android:textSize="13sp"
                android:textColor="#6C757D"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_participants_catalog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👥 30 max participantes"
                android:textSize="13sp"
                android:textColor="#28A745"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Línea divisoria sutil -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#E9ECEF" />

        <!-- Footer con acción -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Toca para ver detalles"
            android:textSize="11sp"
            android:textColor="#6C757D"
            android:gravity="center"
            android:textStyle="italic" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
